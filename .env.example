# Copy this file to ".env" and change the values if needed.

# Where the Vite dev server forwards /api requests (the ASP.NET Core back-end).
# Must match "applicationUrl" in SWP_SportCenter.Api/Properties/launchSettings.json.
VITE_API_PROXY_TARGET=http://localhost:5047

# Leave EMPTY in development (requests go through the proxy above).
# Set it only for a production build that talks to a deployed API, e.g. https://api.example.com
VITE_API_BASE_URL=
